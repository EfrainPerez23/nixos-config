{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "nixos_small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    },
    "color": {
      "1": "#cba6f7",
      "2": "#89b4fa"
    }
  },
  "display": {
    "separator": " ❯ ",
    "color": {
      "keys": "#cba6f7",
      "title": "#89b4fa",
      "separator": "#6c7086"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#cba6f7",
        "at": "#6c7086",
        "host": "#89b4fa"
      }
    },
    "separator",
    { "type": "os", "key": "󱄅 OS" },
    { "type": "kernel", "key": "󰌽 Kernel" },
    { "type": "uptime", "key": "󰅐 Uptime" },
    { "type": "packages", "key": "󰏖 Pkgs" },
    { "type": "de", "key": "󰕮 DE" },
    { "type": "shell", "key": "󰈺 Shell" },
    { "type": "terminal", "key": "󰆍 Term" },
    { "type": "cpu", "key": "󰻠 CPU", "showPeCoreCount": false },
    { "type": "gpu", "key": "󰢮 GPU" },
    { "type": "memory", "key": "󰍛 RAM" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
